# Configurações do Backend Deal Hunter para Nuvem (Render) e Local
# No Render, essas variáveis são configuradas no painel 'Environment' do seu Web Service.

# Porta dinâmica (definida automaticamente pelo Render na nuvem)
PORT=3000

# HOST deve ser 0.0.0.0 na nuvem para aceitar conexões externas
HOST=0.0.0.0

# Conexão PostgreSQL (fornecida automaticamente pelo Render quando você cria o PostgreSQL)
# Exemplo Render: postgres://dealhunter:SENHA@dpg-xxx-a.oregon-postgres.render.com/dealhunter
DATABASE_URL=

# Caminho do banco SQLite caso queira rodar localmente sem PostgreSQL
DATABASE_PATH=./data/deal-hunter.db

# Token fixo de API (opcional - se vazio, um token seguro é gerado e armazenado automaticamente)
API_TOKEN=

# URL do portal Web de autenticação
WEB_AUTH_URL=https://deal-hunter-guilhermernascimento-9353s-projects.vercel.app
