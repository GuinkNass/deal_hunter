{
  "manifest_version": 3,
  "name": "Deal Hunter — Monitor de Ofertas",
  "version": "2.9.0",
  "description": "Monitora categorias da Amazon Brasil, Magalu e Eletroclub e envia alertas de preço ao Telegram.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": { "default_path": "sidepanel/sidepanel.html" },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background/background.js"
  },
  "permissions": ["storage", "alarms", "sidePanel", "scripting", "tabs"],
  "externally_connectable": {
    "matches": [
      "https://*.vercel.app/*",
      "http://localhost:3000/*",
      "http://127.0.0.1:3000/*"
    ]
  },
  "host_permissions": [
    "http://127.0.0.1:3000/*",
    "http://localhost:3000/*",
    "https://*.vercel.app/*",
    "*://*.amazon.com.br/*",
    "*://*.magazineluiza.com.br/*",
    "*://*.eletroclub.com.br/*",
    "*://eletroclub.com.br/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com.br/*",
        "*://*.magazineluiza.com.br/*",
        "*://*.eletroclub.com.br/*",
        "*://eletroclub.com.br/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.vercel.app/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": ["content/auth-sync.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [{
    "resources": ["sidepanel/assets/alert.gif"],
    "matches": [
      "*://*.amazon.com.br/*",
      "*://*.magazineluiza.com.br/*",
      "*://*.eletroclub.com.br/*",
      "*://eletroclub.com.br/*"
    ]
  }]
}
