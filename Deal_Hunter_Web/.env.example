# ==============================================================================
# DEAL HUNTER — VARIÁVEIS DE AMBIENTE (Next.js / Vercel / Supabase / Stripe)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Configurações do Projeto no Supabase: Settings -> API)
# ------------------------------------------------------------------------------
# URL do projeto Supabase (ex: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave Anônima Pública (Anon Key / Public) — utilizada no frontend
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anon_publica_aqui

# Chave de Serviço Secreta (Service Role Key) — NUNCA expor no cliente!
# Utilizada exclusivamente no backend e no webhook para bypassar RLS e atualizar perfis
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_secreta_aqui

# ------------------------------------------------------------------------------
# 2. STRIPE (Configurações da Conta no Stripe: Dashboard -> Developers -> API Keys)
# ------------------------------------------------------------------------------
# Chave Secreta do Stripe (Secret Key: sk_test_... ou sk_live_...)
STRIPE_SECRET_KEY=sk_test_sua_chave_secreta_aqui

# Segredo do Webhook do Stripe (Signing Secret: whsec_...)
# Obtido após configurar o endpoint no Stripe Dashboard (ex: https://seu-dominio.vercel.app/api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=whsec_seu_webhook_secret_aqui

# ID do Preço da Assinatura Recorrente no Stripe (Price ID: price_...)
# Criado no Stripe Dashboard -> Products -> Add Product / Price
STRIPE_PRICE_ID=price_seu_price_id_aqui
STRIPE_PRICE_ID_PRO=price_seu_price_id_aqui

# ------------------------------------------------------------------------------
# 3. EXTENSÃO CHROME & DOMÍNIO DO SITE
# ------------------------------------------------------------------------------
# ID da sua Extensão Chrome instalada (Obtido em chrome://extensions no Modo Desenvolvedor)
NEXT_PUBLIC_EXTENSION_ID=seu_id_da_extensao_aqui

# URL Base pública do site na Vercel (sem barra final)
# Em desenvolvimento local: http://localhost:3000
# Em produção: https://deal-hunter-auth.vercel.app
NEXT_PUBLIC_SITE_URL=https://seu-dominio.vercel.app

# ------------------------------------------------------------------------------
# 4. MERCADO LIVRE OAUTH (DevCenter Mercado Livre)
# ------------------------------------------------------------------------------
ML_CLIENT_ID=226238620730357
ML_CLIENT_SECRET=dsjLowWybTxjm2I3EKo6PThe3X4oCEMO
ML_REDIRECT_URI=https://www.dealhunterpro.com.br/api/ml/callback
MERCADOLIVRE_APP_ID=226238620730357
MERCADOLIVRE_SECRET_KEY=dsjLowWybTxjm2I3EKo6PThe3X4oCEMO
MERCADOLIVRE_REDIRECT_URI=https://www.dealhunterpro.com.br/api/ml/callback

